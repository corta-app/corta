{
 "nombre": "Corta",
 "id": "corta",
 "version": "0.3.0",
 "repo": "corta-app/corta",
 "datos": "visible",
 "privado": true,
 "icono": "docs/favicon.svg",
 "plataformas": [
  "mac"
 ],
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "bienvenida": "bool",
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "modelo": [
   "turbo",
   "small"
  ],
  "idioma_audio": {
   "tipo": "texto",
   "patron": "auto|[a-z]{2,3}"
  },
  "tema": [
   "sistema",
   "claro",
   "oscuro",
   "vidrio"
  ]
 },
 "catalogo": {
  "repo": "corta-app/corta-catalogo",
  "rama": "main",
  "tipos": {
   "efectos": {
    "validador": "efecto_formato",
    "indice": "efectos/index.json",
    "max_bytes": 65536,
    "max_indice": 524288,
    "max_en_indice": 500,
    "singular": "efecto",
    "funcion": "validar_efecto",
    "campos": "CLAVES"
   },
   "plantillas": {
    "validador": "plantilla_formato",
    "indice": "plantillas/index.json",
    "max_bytes": 65536,
    "max_indice": 524288,
    "max_en_indice": 500,
    "singular": "plantilla",
    "funcion": "validar_plantilla",
    "campos": "CLAVES"
   }
  }
 },
 "acciones": {
  "guardarProyecto": {
   "script": "guardar.py",
   "args": [
    "proyecto"
   ],
   "entrada": "archivo",
   "datos": {
    "carpeta": {
     "tipo": "texto",
     "max": 4096,
     "requerido": true
    },
    "*": "pasar"
   },
   "inyectar": {
    "carpeta_real": "proyecto"
   },
   "responde": "proyectoGuardado",
   "limite": 60,
   "eco": [
    "carpeta"
   ],
   "cola": "escritura",
   "maximo": 52428800,
   "scriptDeLaApp": true
  },
  "deshacer": {
   "script": "guardar.py",
   "args": [
    "deshacer"
   ],
   "entrada": "archivo",
   "datos": {
    "carpeta": {
     "tipo": "texto",
     "max": 4096,
     "requerido": true
    }
   },
   "inyectar": {
    "carpeta_real": "proyecto"
   },
   "responde": "deshecho",
   "limite": 60,
   "eco": [
    "carpeta"
   ],
   "cola": "escritura",
   "scriptDeLaApp": true
  },
  "limpiar": {
   "script": "limpiar.py",
   "args": [
    "entrada"
   ],
   "entrada": "archivo",
   "datos": {
    "carpeta": {
     "tipo": "texto",
     "max": 4096,
     "requerido": true
    },
    "muletillas": {
     "tipo": "bool"
    },
    "*": "pasar"
   },
   "inyectar": {
    "carpeta_real": "proyecto"
   },
   "responde": "limpiado",
   "limite": 1800,
   "eco": [
    "carpeta"
   ],
   "cola": "escritura",
   "scriptDeLaApp": true
  },
  "pedirIA": {
   "script": "editar_ia.py",
   "args": [
    "entrada",
    "pedir"
   ],
   "entrada": "archivo",
   "datos": {
    "carpeta": {
     "tipo": "texto",
     "max": 4096,
     "requerido": true
    },
    "texto": {
     "tipo": "texto",
     "max": 2000,
     "recortar": true
    }
   },
   "inyectar": {
    "carpeta_real": "proyecto"
   },
   "responde": "iaRespondio",
   "limite": 900,
   "eco": [
    "carpeta"
   ],
   "scriptDeLaApp": true
  },
  "buscarShorts": {
   "script": "editar_ia.py",
   "args": [
    "entrada",
    "shorts"
   ],
   "entrada": "archivo",
   "datos": {
    "carpeta": {
     "tipo": "texto",
     "max": 4096,
     "requerido": true
    }
   },
   "inyectar": {
    "carpeta_real": "proyecto"
   },
   "responde": "shortsListos",
   "limite": 900,
   "eco": [
    "carpeta"
   ],
   "scriptDeLaApp": true
  },
  "crearShort": {
   "script": "editar_ia.py",
   "args": [
    "entrada",
    "crear_short"
   ],
   "entrada": "archivo",
   "datos": {
    "carpeta": {
     "tipo": "texto",
     "max": 4096,
     "requerido": true
    },
    "titulo": {
     "tipo": "texto",
     "max": 80,
     "recortar": true
    },
    "*": "pasar"
   },
   "inyectar": {
    "carpeta_real": "proyecto"
   },
   "responde": "shortCreado",
   "limite": 900,
   "scriptDeLaApp": true
  },
  "vocabulario": {
   "script": "vocabulario.py",
   "args": [
    "entrada"
   ],
   "entrada": "archivo",
   "datos": {
    "accion": {
     "tipo": "enum",
     "valores": [
      "agregar",
      "quitar",
      "palabra",
      "quitar_palabra"
     ],
     "requerido": true
    },
    "de": {
     "tipo": "texto",
     "max": 60,
     "recortar": true
    },
    "a": {
     "tipo": "texto",
     "max": 60,
     "recortar": true
    },
    "palabra": {
     "tipo": "texto",
     "max": 60,
     "recortar": true
    }
   },
   "responde": "vocabularioActualizado",
   "cola": "escritura",
   "limite": 60,
   "scriptDeLaApp": true
  }
 },
 "sin_acciones": [
  "listaIA",
  "modelosVoz",
  "catalogoInstalados",
  "catalogoQuitar",
  "catalogoUltima"
 ],
 "empaquetado": {
  "descripcion": "Editor de video para Shorts, Reels y TikTok: edita el texto y se corta el video, todo en tu computador.",
  "categoria": "public.app-category.video",
  "linux_categoria": "Video",
  "carpetas": [
   "estilos",
   "efectos",
   "plantillas"
  ],
  "quitar": [
   "ui/demo"
  ],
  "permisos": [],
  "ocupada": [
   {
    "proceso": "bin/render.py",
    "mensaje": "✗ Corta está exportando un video. Espera a que termine."
   },
   {
    "proceso": "bin/importar.py",
    "mensaje": "✗ Corta está transcribiendo o trayendo un video. Espera a que termine."
   }
  ],
  "whisper": true,
  "licencias": [
   "ffmpeg y ffprobe (https://ffmpeg.org), compilación estática de ffmpeg-static b6.1.1 (https://github.com/eugeneware/ffmpeg-static), licencia GPL; el código fuente está en https://ffmpeg.org/download.html"
  ],
  "mac": {
   "binarios": [
    {
     "nombre": "ffmpeg",
     "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-darwin-arm64.gz",
     "sha256": "8923876afa8db5585022d7860ec7e589af192f441c56793971276d450ed3bbfa",
     "gz": true
    },
    {
     "nombre": "ffprobe",
     "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffprobe-darwin-arm64.gz",
     "sha256": "d986a8ec7b030899fe66a8a288ed809a3543338705a3ce178cfb85869c5d80be",
     "gz": true
    }
   ]
  }
 }
}
